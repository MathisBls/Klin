# Copier en .env et remplir. Le .env n'est jamais commite (voir .gitignore).
#
# Cle Open Cloud creee sur https://create.roblox.com/dashboard/credentials
# Scopes requis (voir `make doctor` pour verifier lesquels manquent) :
#   - Place Management  : lecture + ecriture sur l'univers  -> publish
#   - Assets            : lecture + ecriture sur le createur -> assets
#   - Developer Products: lecture + ecriture sur l'univers  -> products
#   - Analytics         : lecture sur l'univers             -> analytics
#   - Luau Execution    : ecriture sur l'univers            -> test
# Ne pas mettre de restriction IP sur la cle (ou alors ton IP publique).
ROBLOX_API_KEY=

# Onglet Configure de l'experience sur le Creator Dashboard.
ROBLOX_UNIVERSE_ID=

# ID de la place de depart (celui dans l'URL roblox.com/games/<placeId>/...).
ROBLOX_PLACE_ID=

# Creator pour l upload d assets : ton userId Roblox,
# ou ROBLOX_CREATOR_GROUP_ID si le jeu appartient a un groupe.
ROBLOX_CREATOR_USER_ID=
ROBLOX_CREATOR_GROUP_ID=
